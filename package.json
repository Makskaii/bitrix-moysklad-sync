{
  "name": "bitrix-moysklad-sync",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "build": "npm run db:generate && npm run build --workspace @sync/api && npm run build --workspace @sync/web",
    "db:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  }
}
